# Data corpora (generated by scripts; never committed)
# data/eval/*.jpg          — accuracy corpus built by scripts/build_test_corpus.py
# data/hard_eval/          — hardness corpus built by scripts/hard_eval.py
# data/internet_test/      — face-detection corpus, downloaded separately
# data/sample_face.jpg     — demo seed (auto-downloaded on first run of scripts/demo.py)
# data/satya_nadella_official.jpg
# data/saurav_joshi.jpg
# data/test_a.jpg
# data/test_b.jpg
data/eval/*.jpg
